---
// Without a 404 page, Cloudflare Pages answers every unknown address with the home page, including a GET of the
// registration API's POST-only addresses.
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
	<h1>Page not found</h1>
	<p><a href="/">Go to the home page</a>.</p>
</Base>
