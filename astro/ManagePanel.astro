---
// Events&I – Copyright (C) 2026 andeye Ltd. AGPL-3.0, see ../LICENSE.
/** Self-service view/change/cancel page, driven by the signed token in ?t=. */
interface Props {
	/** Label for the in-person attendance choice, e.g. "In person at White City". Overrides the event's in_person_label. */
	inPersonLabel?: string;
	/** Label for the remote attendance choice. */
	remoteLabel?: string;
	/** Legend for the tour choices, shown only when the event has tours. */
	tourLegend?: string;
}
const { inPersonLabel, remoteLabel, tourLegend } = Astro.props;
---
<div class="not-content" id="manage">
	<p id="manage-loading" role="status">Loading your registration…</p>
	<noscript><p>Managing your registration needs JavaScript. Please turn it on, or contact the organisers.</p></noscript>
	<form id="manage-form" hidden novalidate>
		<p id="manage-summary" class="summary"></p>
		<div class="field">
			<label for="m-name">Name</label>
			<input id="m-name" name="name" type="text" required maxlength="120" autocomplete="name" />
		</div>
		<p class="help">Email: <span id="m-email"></span>. To use a different address, cancel and register again.</p>
		<fieldset class="field">
			<legend>How will you attend?</legend>
			<label class="choice"><input type="radio" name="attendance" value="in_person" /> <span id="m-in-person-label" data-fixed={inPersonLabel ? "1" : undefined}>{inPersonLabel ?? "In person"}</span></label>
			<label class="choice"><input type="radio" name="attendance" value="remote" /> <span id="m-remote-label" data-fixed={remoteLabel ? "1" : undefined}>{remoteLabel ?? "Remotely (online sessions only)"}</span></label>
			<label class="choice" id="m-extras-choice" hidden><input type="radio" name="attendance" value="extras" /> <span id="m-extras-label">Just the optional sessions</span></label>
			<p class="help" id="m-closed" hidden>Registration has closed: you can still switch to remote or cancel.</p>
		</fieldset>
		<fieldset class="field" id="m-tour-fs" hidden>
			<legend id="m-tour-legend" data-fixed={tourLegend ? "1" : undefined}>{tourLegend ?? "Optional tour (in person only)"}</legend>
			<label class="choice"><input type="radio" name="tour_id" value="none" /> No tour, thanks</label>
			<div id="m-tours"></div>
		</fieldset>
		<fieldset class="field" id="m-optins-fieldset" hidden>
			<legend id="m-optins-legend">Also joining us for (in person only)</legend>
			<div id="m-optins"></div>
		</fieldset>
		<div class="field">
			<label for="m-affiliation">Organisation or affiliation (optional)</label>
			<input id="m-affiliation" name="affiliation" type="text" maxlength="200" />
		</div>
		<div class="field">
			<label for="m-needs">Dietary or access needs (optional)</label>
			<textarea id="m-needs" name="needs" rows="3" maxlength="1000"></textarea>
		</div>
		<div class="field" id="m-extra-field" hidden>
			<label for="m-extra" id="m-extra-label">Anything else (optional)</label>
			<textarea id="m-extra" name="extra_answer" rows="2" maxlength="500"></textarea>
		</div>
		<label class="choice"><input type="checkbox" name="share_contact" id="m-share" /> Share my email address and organisation with the hosts of the sessions I attend (otherwise hosts see only your name and whether you have a place, so if plans change at the last minute they may not be able to reach you directly)</label>
		<div id="m-calendar"></div>
		<p class="help">Moving to a different tour, or from remote to in person, is subject to availability: if it is full you join the waiting list.</p>
		<div class="actions">
			<button type="submit" id="m-save" class="primary">Save changes</button>
			<button type="button" id="m-cancel" class="danger">Cancel my registration</button>
		</div>
		<div id="manage-result" role="status" aria-live="polite"></div>
	</form>
	<div id="m-polls" hidden></div>
</div>
<script>
	import './manage-panel';
</script>
<style>
	#manage-form { display: grid; gap: 1rem; max-width: 40rem; margin-block: 1.5rem; }
	.summary { font-weight: 600; }
	.field { display: grid; gap: 0.35rem; border: 0; padding: 0; margin: 0; }
	.field label:not(.choice), legend { font-weight: 600; }
	/* :global because the tour and opt-in choices are added by the script, out of reach of Astro's scoped styles. */
	#manage-form :global(.choice) { display: flex; gap: 0.5rem; align-items: flex-start; }
	#manage-form :global(.choice input) { margin-top: 0.3rem; }
	#m-tours, #m-optins { display: grid; gap: 0.35rem; }
	input[type='text'], textarea { padding: 0.5rem; border: 1px solid var(--sl-color-gray-3, #8b8f98); border-radius: 0.3rem; background: var(--sl-color-bg, Canvas); color: var(--sl-color-text, CanvasText); font: inherit; }
	fieldset:disabled { opacity: 0.6; }
	/* :global because the polls are built by the script. */
	#m-polls { display: grid; gap: 1.5rem; max-width: 40rem; margin-block: 1.5rem; }
	#m-polls :global(.poll) { display: grid; gap: 0.75rem; }
	#m-polls :global(h2) { margin: 0; }
	#m-polls :global(.rank) { list-style: decimal; padding-left: 1.75rem; margin: 0; display: grid; gap: 0.35rem; }
	#m-polls :global(.rank li) { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem; border: 1px solid var(--sl-color-gray-4, #c7cad1); border-radius: 0.3rem; background: var(--sl-color-bg, Canvas); color: var(--sl-color-text, CanvasText); }
	#m-polls :global(.rank li[draggable='true']) { cursor: grab; }
	#m-polls :global(.rank li.dragging) { opacity: 0.5; }
	#m-polls :global(.rank li.bar) { list-style: none; margin-left: -1.75rem; border: 0; border-top: 3px dashed #b3261e; border-top-color: light-dark(#b3261e, #ff8a80); border-radius: 0; font-weight: 700; color: #b3261e; color: light-dark(#b3261e, #ff8a80); background: transparent; }
	/* Starlight's dark theme may not set color-scheme, so light-dark() alone could keep the light red. */
	:global([data-theme='dark']) #m-polls :global(.rank li.bar) { color: #ff8a80; border-top-color: #ff8a80; }
	#m-polls :global(.tag) { font-size: var(--sl-text-xs, 0.75rem); font-weight: 400; margin-left: 0.5rem; padding: 0.05rem 0.4rem; border-radius: 0.25rem; background: #eef0f3; background: light-dark(#eef0f3, #2a2d33); color: var(--sl-color-text, CanvasText); }
	:global([data-theme]) #m-polls :global(.tag) { background: var(--sl-color-gray-6); }
	#m-polls :global(.moves) { display: flex; gap: 0.25rem; flex-shrink: 0; }
	#m-polls :global(.moves button) { min-width: 2.25rem; min-height: 2.25rem; border: 1px solid var(--sl-color-gray-3, #8b8f98); border-radius: 0.3rem; background: transparent; color: inherit; cursor: pointer; }
	#m-polls :global(.moves button:disabled) { opacity: 0.35; cursor: default; }
	#m-polls :global(.suggest) { display: flex; gap: 0.5rem; flex-wrap: wrap; }
	#m-polls :global(.suggest input) { flex: 1 1 14rem; }
	#m-polls :global(.secondary) { background: transparent; color: var(--sl-color-text, inherit); border: 2px solid #0069a0; border-radius: 999px; padding: 0.5rem 1.2rem; font-weight: 700; cursor: pointer; }
	#m-polls :global(table) { border-collapse: collapse; margin-top: 0.5rem; }
	#m-polls :global(th), #m-polls :global(td) { padding: 0.25rem 0.75rem 0.25rem 0; text-align: left; }
	.help { font-size: var(--sl-text-sm, 0.875rem); color: #4b5563; color: light-dark(#4b5563, #b0b5bd); margin: 0; }
	/* Starlight's own grey where it is used; elsewhere the plain colours above (var() with light-dark() inside has no fallback in older browsers). */
	:global([data-theme]) .help { color: var(--sl-color-gray-2); }
	.actions { display: flex; gap: 1rem; flex-wrap: wrap; }
	.actions button:disabled { opacity: 0.6; cursor: wait; }
	#manage :global(.primary) { background: #0069a0; color: #fff; border: 0; border-radius: 999px; padding: 0.6rem 1.4rem; font-weight: 700; cursor: pointer; }
	.danger { background: transparent; color: var(--sl-color-text, inherit); border: 2px solid #b3261e; border-radius: 999px; padding: 0.5rem 1.2rem; font-weight: 700; cursor: pointer; }
</style>
