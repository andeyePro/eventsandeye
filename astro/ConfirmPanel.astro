interface Props { contactHref: string }
const { contactHref } = Astro.props;
/** Landing page for the "Complete registration" link. Confirmation is a POST behind a button, so link scanners cannot confirm. */
---
<div class="not-content panel" id="confirm-panel" data-contact={contactHref}>
	<p id="confirm-intro">Click the button to confirm your email address and complete your registration.</p>
	<button type="button" id="confirm-btn" class="big">Complete registration</button>
	<noscript><p>Confirming needs JavaScript. Please turn it on, or <a href={contactHref}>contact us</a>.</p></noscript>
	<div id="confirm-result" role="status" aria-live="polite" tabindex="-1"></div>
	<p class="help"><a href={contactHref}>Contact us</a> if something is not right.</p>
</div>
<script>
	import './confirm-panel';
</script>
<style>
	.panel { margin-block: 1.5rem; }
	.big { background: #0069a0; color: #fff; border: 0; border-radius: 0.4rem; padding: 0.9rem 1.8rem; font-size: var(--sl-text-lg, 1.125rem); font-weight: 700; cursor: pointer; }
	.big:disabled { opacity: 0.6; }
</style>
