---
// Events&I – Copyright (C) 2026 andeye Ltd. AGPL-3.0, see ../LICENSE.
interface Props {
	event: string;
	/** Data controller named in the consent text, e.g. "Example Organisers Ltd". */
	controller: string;
	/** Where to send people with problems: a mailto: or a contact-form URL. */
	contactHref: string;
	privacyHref?: string;
	/** Where Events&I's source and feedback live. */
	sourceUrl?: string;
	/** The page shown after a successful registration. */
	next?: string;
	/** Label for the in-person attendance choice, e.g. "In person at White City". Overrides the event's in_person_label. */
	inPersonLabel?: string;
	/** Label for the remote attendance choice. */
	remoteLabel?: string;
	/** Legend for the tour choices, shown only when the event has tours. */
	tourLegend?: string;
}
const { event, controller, contactHref, privacyHref = '/privacy/', sourceUrl = 'https://github.com/andeyePro/eventsandeye', next = '/events/check-email/', inPersonLabel, remoteLabel, tourLegend } = Astro.props;
// A test build takes the test key even when the real one is set (in .env.production, say): the real widget refuses to
// run on localhost.
const TEST_KEY = '1x00000000000000000000AA';
// Cloudflare Pages sets CF_PAGES on its builds: a test build there would ship a key the live server refuses.
if (import.meta.env.PUBLIC_TURNSTILE_ALLOW_TEST_KEY === 'true' && typeof process !== 'undefined' && process.env.CF_PAGES === '1') throw new Error('PUBLIC_TURNSTILE_ALLOW_TEST_KEY is for local test builds only: remove it from this Cloudflare Pages build.');
const siteKey = import.meta.env.PUBLIC_TURNSTILE_ALLOW_TEST_KEY === 'true' ? TEST_KEY : import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV ? TEST_KEY : undefined);
// A production build without a real site key would ship Cloudflare's always-pass test key and every registration would fail.
if (!siteKey) throw new Error('Set PUBLIC_TURNSTILE_SITE_KEY for production builds (or PUBLIC_TURNSTILE_ALLOW_TEST_KEY=true for local test builds).');
---
<form class="rsvp not-content" id="rsvp-form" data-event={event} data-contact={contactHref} data-next={next} method="post" novalidate>
	<p class="status-line" id="rsvp-availability" aria-live="polite">Checking availability…</p>

	<div class="field">
		<label for="rsvp-name">Name <span aria-hidden="true">*</span></label>
		<input id="rsvp-name" name="name" type="text" autocomplete="name" required maxlength="120" />
	</div>
	<div class="field">
		<label for="rsvp-email">Email <span aria-hidden="true">*</span></label>
		<input id="rsvp-email" name="email" type="email" autocomplete="email" required maxlength="254" />
	</div>

	<fieldset class="field">
		<legend>How will you attend? <span aria-hidden="true">*</span></legend>
		<label class="choice"><input type="radio" name="attendance" value="in_person" required /> <span id="rsvp-in-person-label" data-fixed={inPersonLabel ? "1" : undefined}>{inPersonLabel ?? "In person"}</span></label>
		<label class="choice"><input type="radio" name="attendance" value="remote" /> <span id="rsvp-remote-label" data-fixed={remoteLabel ? "1" : undefined}>{remoteLabel ?? "Remotely (online sessions only)"}</span></label>
		<label class="choice" id="rsvp-extras-choice" hidden><input type="radio" name="attendance" value="extras" /> <span id="rsvp-extras-label">Just the optional sessions</span></label>
	</fieldset>

	<fieldset class="field" id="rsvp-tour-fieldset" hidden>
		<legend id="rsvp-tour-legend" data-fixed={tourLegend ? "1" : undefined}>{tourLegend ?? "Optional tour (in person only)"}</legend>
		<label class="choice"><input type="radio" name="tour_id" value="none" checked /> No tour, thanks</label>
		<div id="rsvp-tours"></div>
	</fieldset>

	<fieldset class="field" id="rsvp-optins-fieldset" hidden>
		<legend id="rsvp-optins-legend">Also joining us for (in person only)</legend>
		<div id="rsvp-optins"></div>
	</fieldset>

	<div class="field">
		<label for="rsvp-affiliation">Organisation or affiliation (optional)</label>
		<input id="rsvp-affiliation" name="affiliation" type="text" autocomplete="organization" maxlength="200" />
	</div>
	<div class="field">
		<label for="rsvp-needs">Dietary or access needs (optional)</label>
		<textarea id="rsvp-needs" name="needs" rows="3" maxlength="1000"></textarea>
	</div>
	<div class="field" id="rsvp-extra-field" hidden>
		<label for="rsvp-extra" id="rsvp-extra-label">Anything else (optional)</label>
		<textarea id="rsvp-extra" name="extra_answer" rows="2" maxlength="500"></textarea>
	</div>

	<div id="rsvp-polls" hidden></div>
	<div class="hp" aria-hidden="true">
		<label for="rsvp-website">Leave this field empty</label>
		<input id="rsvp-website" name="website" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<div class="field consent">
		<label class="choice">
			<input type="checkbox" name="consent" id="rsvp-consent" required />
			<span>I agree that {controller} may use my details, including any dietary or access needs I share, to run this event and email me about it, as in the <a href={privacyHref}>privacy notice</a>. <span aria-hidden="true">*</span></span>
		</label>
		<label class="choice">
			<input type="checkbox" name="share_contact" id="rsvp-share" />
			<span>Optional: share my email address and organisation with the hosts of the sessions I attend, so they can contact me.</span>
		</label>
	</div>

	<div class="cf-turnstile" data-sitekey={siteKey} data-action="eventsandeye-register" data-response-field-name="cf-turnstile-response"></div>

	<p class="help"><span aria-hidden="true">*</span> Required</p>
	<!-- Disabled until the script runs: without it the form would post personal data to this page and go nowhere. -->
	<button type="submit" class="submit" disabled>Register</button>
	<noscript><p class="help">Registering needs JavaScript. Please turn it on, or <a href={contactHref}>contact us</a> to register.</p></noscript>
	<div id="rsvp-result" role="status" aria-live="polite"></div>
	<p class="help beta">Registrations via <a href={sourceUrl}>Events&amp;I</a> (beta): <a href={contactHref}>feedback welcome</a>.</p>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
	import './rsvp-form';
</script>

<style>
	.rsvp { display: grid; gap: 1rem; max-width: 40rem; margin-block: 1.5rem; }
	.field { display: grid; gap: 0.35rem; border: 0; padding: 0; margin: 0; }
	.field label:not(.choice), legend { font-weight: 600; }
	/* :global because tour and opt-in choices are added by the script after the page loads, and Astro's scoped
	   styles only reach elements written in this file. */
	.rsvp :global(.choice) { display: flex; gap: 0.5rem; align-items: flex-start; font-weight: normal; }
	.rsvp :global(.choice input) { margin-top: 0.3rem; }
	#rsvp-tours, #rsvp-optins { display: grid; gap: 0.35rem; }
	#rsvp-polls { display: grid; gap: 1rem; }
	#rsvp-polls :global(.rank) { list-style: decimal; padding-left: 1.75rem; margin: 0; display: grid; gap: 0.35rem; }
	#rsvp-polls :global(.rank li) { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; padding: 0.4rem 0.6rem; border: 1px solid var(--sl-color-gray-4, #c7cad1); border-radius: 0.3rem; background: var(--sl-color-bg, Canvas); color: var(--sl-color-text, CanvasText); }
	#rsvp-polls :global(.rank li[draggable='true']) { cursor: grab; }
	#rsvp-polls :global(.rank li.dragging) { opacity: 0.5; }
	#rsvp-polls :global(.rank li.bar) { list-style: none; margin-left: -1.75rem; border: 0; border-top: 3px dashed #b3261e; border-top-color: light-dark(#b3261e, #ff8a80); border-radius: 0; font-weight: 700; color: #b3261e; color: light-dark(#b3261e, #ff8a80); background: transparent; }
	/* Starlight's dark theme may not set color-scheme, so light-dark() alone could keep the light red. */
	:global([data-theme='dark']) #rsvp-polls :global(.rank li.bar) { color: #ff8a80; border-top-color: #ff8a80; }
	#rsvp-polls :global(.moves) { display: flex; gap: 0.25rem; flex-shrink: 0; }
	#rsvp-polls :global(.moves button) { min-width: 2.25rem; min-height: 2.25rem; border: 1px solid var(--sl-color-gray-3, #8b8f98); border-radius: 0.3rem; background: transparent; color: inherit; cursor: pointer; }
	#rsvp-polls :global(.moves button:disabled) { opacity: 0.35; cursor: default; }
	input[type='text'], input[type='email'], textarea {
		padding: 0.5rem; border: 1px solid var(--sl-color-gray-3, #8b8f98); border-radius: 0.3rem; background: var(--sl-color-bg, Canvas); color: var(--sl-color-text, CanvasText); font: inherit;
	}
	fieldset:disabled { opacity: 0.6; }
	.help { font-size: var(--sl-text-sm, 0.875rem); color: #4b5563; color: light-dark(#4b5563, #b0b5bd); margin: 0; }
	/* Starlight's own grey where it is used; elsewhere the plain colours above (var() with light-dark() inside has no fallback in older browsers). */
	:global([data-theme]) .help { color: var(--sl-color-gray-2); }
	.hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
	.submit { justify-self: start; background: var(--sl-color-accent-high, #0069a0); color: var(--sl-color-black, #fff); border: 0; border-radius: 999px; padding: 0.7rem 1.6rem; font-weight: 700; font-size: var(--sl-text-base, 1rem); cursor: pointer; }
	:global([data-theme='light']) .submit { background: #0069a0; color: #fff; }
	.submit:disabled { opacity: 0.6; cursor: wait; }
	.status-line { font-weight: 600; }
	#rsvp-result :global(.notice) { padding: 1rem; border: 2px solid var(--sl-color-accent, #0069a0); border-radius: 0.5rem; }
</style>
