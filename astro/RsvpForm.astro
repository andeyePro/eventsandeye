---
// Events&I – Copyright (C) 2026 andeye Ltd. AGPL-3.0, see ../LICENSE.
interface Props {
	event: string;
	/** Data controller named in the consent text, e.g. "Example Organisers Ltd". */
	controller: string;
	/** Where to send people with problems: a mailto: or a contact-form URL. */
	contactHref: string;
	privacyHref?: string;
	/** Where Events&I's source and feedback live. */
	sourceUrl?: string;
	/** The page shown after a successful registration. */
	next?: string;
}
const { event, controller, contactHref, privacyHref = '/privacy/', sourceUrl = 'https://github.com/andeyePro/eventsandeye', next = '/events/check-email/' } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || (import.meta.env.DEV || import.meta.env.PUBLIC_TURNSTILE_ALLOW_TEST_KEY === 'true' ? '1x00000000000000000000AA' : undefined);
// A production build without a real site key would ship Cloudflare's always-pass test key and every registration would fail.
if (!siteKey) throw new Error('Set PUBLIC_TURNSTILE_SITE_KEY for production builds (or PUBLIC_TURNSTILE_ALLOW_TEST_KEY=true for local test builds).');
---
<form class="rsvp not-content" id="rsvp-form" data-event={event} data-contact={contactHref} data-next={next} novalidate>
	<p class="status-line" id="rsvp-availability" aria-live="polite">Checking availability…</p>

	<div class="field">
		<label for="rsvp-name">Name <span aria-hidden="true">*</span></label>
		<input id="rsvp-name" name="name" type="text" autocomplete="name" required maxlength="120" />
	</div>
	<div class="field">
		<label for="rsvp-email">Email <span aria-hidden="true">*</span></label>
		<input id="rsvp-email" name="email" type="email" autocomplete="email" required maxlength="254" />
	</div>

	<fieldset class="field">
		<legend>How will you attend? <span aria-hidden="true">*</span></legend>
		<label class="choice"><input type="radio" name="attendance" value="in_person" required /> In person at White City</label>
		<label class="choice"><input type="radio" name="attendance" value="remote" /> Remotely, talks only, on Google Meet</label>
		<label class="choice" id="rsvp-extras-choice" hidden><input type="radio" name="attendance" value="extras" /> <span id="rsvp-extras-label">Just the optional sessions</span></label>
	</fieldset>

	<fieldset class="field" id="rsvp-tour-fieldset">
		<legend>Optional lab tour (in person only)</legend>
		<label class="choice"><input type="radio" name="tour_id" value="none" checked /> No tour, thanks</label>
		<div id="rsvp-tours"></div>
	</fieldset>

	<fieldset class="field" id="rsvp-optins-fieldset" hidden>
		<legend id="rsvp-optins-legend">Also joining us for (in person only)</legend>
		<div id="rsvp-optins"></div>
	</fieldset>

	<div class="field">
		<label for="rsvp-affiliation">Organisation or affiliation (optional)</label>
		<input id="rsvp-affiliation" name="affiliation" type="text" autocomplete="organization" maxlength="200" />
	</div>
	<div class="field">
		<label for="rsvp-needs">Dietary or access needs (optional)</label>
		<textarea id="rsvp-needs" name="needs" rows="3" maxlength="1000"></textarea>
	</div>
	<div class="field" id="rsvp-extra-field" hidden>
		<label for="rsvp-extra" id="rsvp-extra-label">Anything else (optional)</label>
		<textarea id="rsvp-extra" name="extra_answer" rows="2" maxlength="500"></textarea>
	</div>

	<div class="hp" aria-hidden="true">
		<label for="rsvp-website">Leave this field empty</label>
		<input id="rsvp-website" name="website" type="text" tabindex="-1" autocomplete="off" />
	</div>

	<div class="field consent">
		<label class="choice">
			<input type="checkbox" name="consent" id="rsvp-consent" required />
			<span>I agree that {controller} may use my details, including any dietary or access needs I share, to run this event and email me about it, as in the <a href={privacyHref}>privacy notice</a>. <span aria-hidden="true">*</span></span>
		</label>
		<label class="choice">
			<input type="checkbox" name="share_contact" id="rsvp-share" />
			<span>Optional: share my email address with the hosts of my sessions, so they can contact me.</span>
		</label>
	</div>

	<div class="cf-turnstile" data-sitekey={siteKey} data-response-field-name="cf-turnstile-response"></div>

	<p class="help"><span aria-hidden="true">*</span> Required</p>
	<button type="submit" class="submit">Register</button>
	<div id="rsvp-result" role="status" aria-live="polite"></div>
	<p class="help beta">Registrations via <a href={sourceUrl}>Events&amp;I</a> (beta): <a href={contactHref}>feedback welcome</a>.</p>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
	const form = document.getElementById('rsvp-form') as HTMLFormElement;
	const event = form.dataset.event!;
	const result = document.getElementById('rsvp-result')!;
	const avail = document.getElementById('rsvp-availability')!;
	const toursBox = document.getElementById('rsvp-tours')!;
	const tourFs = document.getElementById('rsvp-tour-fieldset') as HTMLFieldSetElement;
	const optFs = document.getElementById('rsvp-optins-fieldset') as HTMLFieldSetElement;

	function syncTour() {
		const mode = (form.elements.namedItem('attendance') as RadioNodeList).value;
		const inPerson = mode === 'in_person', extras = mode === 'extras';
		tourFs.disabled = !inPerson;
		optFs.disabled = !inPerson && !extras;
		document.getElementById('rsvp-optins-legend')!.textContent = extras ? 'Joining us for' : 'Also joining us for (in person only)';
		const boxes = [...optFs.querySelectorAll('input')] as HTMLInputElement[];
		if (!inPerson && !extras) boxes.forEach((el) => (el.checked = false));
		// Just the dinner (say): with only one optional session there's nothing to choose, so tick it.
		if (extras && boxes.length === 1) boxes[0].checked = true;
		if (!inPerson) (form.querySelector('input[name=tour_id][value=none]') as HTMLInputElement).checked = true;
	}
	form.addEventListener('change', syncTour);
	syncTour();

	fetch(`/api/rsvp/status?event=${encodeURIComponent(event)}`)
		.then((r) => r.json())
		.then((s) => {
			if (!s.ok) throw new Error(s.error);
			if (!s.event.open) {
				avail.textContent = 'Registration for this event has closed.';
				form.querySelectorAll('input,textarea,button').forEach((el) => ((el as HTMLInputElement).disabled = true));
				return;
			}
			if (s.event.extra_question) {
				(document.getElementById('rsvp-extra-label') as HTMLElement).textContent = `${s.event.extra_question} (optional)`;
				(document.getElementById('rsvp-extra-field') as HTMLElement).hidden = false;
			}
			const deadline = new Date(s.event.deadline).toLocaleString('en-GB', { dateStyle: 'full', timeStyle: 'short', timeZone: 'Europe/London' });
			// Only the deadline: saying places are full would put people off registering, and the waiting list is how
			// demand beyond the room shows up.
			avail.textContent = `Registration closes ${deadline} (UK time).`;
			for (const t of s.tours) {
				const label = document.createElement('label');
				label.className = 'choice';
				const input = document.createElement('input');
				input.type = 'radio';
				input.name = 'tour_id';
				input.value = t.id;
				input.disabled = !t.open;
				label.append(input, ` ${t.label}${!t.open ? ' (booking closed)' : t.available ? '' : ' (full: waiting list)'}`);
				toursBox.append(label);
			}
			for (const o of s.optins ?? []) {
				const label = document.createElement('label');
				label.className = 'choice';
				const input = document.createElement('input');
				input.type = 'checkbox';
				input.name = 'optins';
				input.value = o.id;
				const time = new Date(o.starts_at).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/London' });
				label.append(input, ` ${o.label}, ${time}${o.location ? `, ${o.location}` : ''}${o.available === false ? ' (full: waiting list)' : ''}`);
				(document.getElementById('rsvp-optins') as HTMLElement).append(label);
			}
			optFs.hidden = !(s.optins ?? []).length;
			if ((s.optins ?? []).length) {
				document.getElementById('rsvp-extras-label')!.textContent = `Just the ${(s.optins as { label: string }[]).map((o) => o.label.toLowerCase()).join(' and ')}`;
				document.getElementById('rsvp-extras-choice')!.hidden = false;
			}
			syncTour();
		})
		.catch(() => {
			avail.textContent = `Could not check availability. You can still try to register, or contact us using the link below.`;
		});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		result.textContent = '';
		if (!form.reportValidity()) return;
		const fd = new FormData(form);
		const body: Record<string, unknown> = Object.fromEntries(fd.entries());
		body.event = event;
		body.consent = (document.getElementById('rsvp-consent') as HTMLInputElement).checked;
		body.share_contact = (document.getElementById('rsvp-share') as HTMLInputElement).checked;
		body.optins = fd.getAll('optins').map(String);
		const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
		btn.disabled = true;
		try {
			const res = await fetch('/api/rsvp/register', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
			const data = await res.json();
			if (!data.ok) throw new Error(data.error || 'Registration failed.');
			// A page of its own, so the "check your email" step can't be missed below the form.
			try { sessionStorage.setItem('rsvp-email', String(fd.get('email'))); } catch {}
			location.href = form.dataset.next || '/events/check-email/';
		} catch (err) {
			result.textContent = (err as Error).message;
			(window as unknown as { turnstile?: { reset: () => void } }).turnstile?.reset();
		} finally {
			btn.disabled = false;
		}
	});
</script>

<style>
	.rsvp { display: grid; gap: 1rem; max-width: 40rem; margin-block: 1.5rem; }
	.field { display: grid; gap: 0.35rem; border: 0; padding: 0; margin: 0; }
	.field label:not(.choice), legend { font-weight: 600; }
	/* :global because tour and opt-in choices are added by the script after the page loads, and Astro's scoped
	   styles only reach elements written in this file. */
	.rsvp :global(.choice) { display: flex; gap: 0.5rem; align-items: flex-start; font-weight: normal; }
	.rsvp :global(.choice input) { margin-top: 0.3rem; }
	#rsvp-tours, #rsvp-optins { display: grid; gap: 0.35rem; }
	input[type='text'], input[type='email'], textarea {
		padding: 0.5rem; border: 1px solid var(--sl-color-gray-3); border-radius: 0.3rem; background: var(--sl-color-bg); color: var(--sl-color-text); font: inherit;
	}
	fieldset:disabled { opacity: 0.6; }
	.help { font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); margin: 0; }
	.hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
	.submit { justify-self: start; background: var(--sl-color-accent-high); color: var(--sl-color-black); border: 0; border-radius: 999px; padding: 0.7rem 1.6rem; font-weight: 700; font-size: var(--sl-text-base); cursor: pointer; }
	:global([data-theme='light']) .submit { background: #0069a0; color: #fff; }
	.submit:disabled { opacity: 0.6; cursor: wait; }
	.status-line { font-weight: 600; }
	#rsvp-result :global(.notice) { padding: 1rem; border: 2px solid var(--sl-color-accent); border-radius: 0.5rem; }
</style>
